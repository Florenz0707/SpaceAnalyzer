{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "检查：pre-commit 与全部测试",
      "type": "process",
      "command": "bash",
      "args": ["scripts/check.sh"],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/check.ps1"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "测试：后端",
      "type": "process",
      "command": "bash",
      "args": ["scripts/check.sh", "backend-tests"],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/check.ps1",
          "-Hook",
          "backend-tests"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "测试：前端",
      "type": "process",
      "command": "bash",
      "args": ["scripts/check.sh", "frontend-tests"],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "scripts/check.ps1",
          "-Hook",
          "frontend-tests"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
